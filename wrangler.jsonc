{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "finance-tracker",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	// Workers Logs (request logs in the Cloudflare dashboard) are turned off.
	"observability": {
		"enabled": false
	},
	// Only reachable through ameyapurandare.com/projects/finance-tracker/app/,
	// which forwards to this Worker via a service binding.
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		// Missing files must 404 (not return the app page), or a stale page would try to run HTML as a script.
		// The Worker falls back to the app page itself for addresses without a file extension.
		"not_found_handling": "none",
		"binding": "ASSETS",
		// Every request goes through the Worker, which strips the URL prefix (see worker/base.ts).
		"run_worker_first": true
	},
	// Limits how often one visitor can submit the install sign-up form.
	"ratelimits": [
		{
			"name": "REGISTER_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "finance-tracker-telemetry",
			"database_id": "8feb30ad-64c7-4a52-85f8-2a2e00dd552d",
			"migrations_dir": "migrations"
		}
	]
}
